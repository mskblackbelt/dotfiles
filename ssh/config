Host github.com
  Hostname ssh.github.com
  Port 443
  User git

Host REDACTED-IP
  # Enable forwarding for rmate installed on server
  RemoteForward 52698 localhost:52698
  # Start zsh on login to remote server 
  RemoteCommand /usr/bin/zsh

Host candyshop
  HostName REDACTED-IP
  User REDACTED
  Port 22
  RequestTTY yes
  
Host sugarcube
  HostName REDACTED-IP
  User REDACTED
  IdentityFile ~/.ssh/heart_of_gold
  RemoteForward 52698 localhost:52698

