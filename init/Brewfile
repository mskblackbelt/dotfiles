# Homebrew bundle for every Mac: brew bundle --file ~/Developer/dotfiles/init/Brewfile
#
# Everything above "Home" and "Work" is installed everywhere. Those two
# sections are commented out; uncomment what a given machine needs.

## Taps

tap "ttscoff/thelab"

## Formulae

### Replacements for UNIX tools

# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Yet another cross-platform graphical process/system monitor
brew "bottom"
# GNU File, Shell, and Text utilities
brew "coreutils"
# Power of curl, ease of use of httpie
brew "curlie"
# Syntax-highlighting pager for git and diff output
brew "git-delta"
# More intuitive version of du in rust
brew "dust"
# Modern replacement for 'ls'
brew "eza"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Command-line fuzzy finder written in Go
brew "fzf"
# Improved top (interactive process viewer)
brew "htop"
# Powerful paging program
brew "most"
# Modern replacement for ps written by Rust
brew "procs"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Intuitive find & replace CLI
brew "sd"
# Official tldr client written in Rust
brew "tlrc"
# Shell extension to navigate your filesystem faster
brew "zoxide"

### Shells and dotfiles

# Bourne-Again SHell, a UNIX command interpreter
brew "bash"
# Programmable completion for Bash 4.2+
brew "bash-completion@2"
# RC file (dotfile) management
brew "rcm"
# Programmatically correct mistyped console commands
brew "thefuck"
# UNIX shell (command interpreter)
brew "zsh"
# Additional completion definitions for zsh
brew "zsh-completions"
# Fish shell like syntax highlighting for zsh
brew "zsh-fast-syntax-highlighting"

### Git

# Structural diff that understands syntax (git difftool)
brew "difftastic"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"

### Writing and typesetting

# Unified Markdown processor supporting CommonMark, GFM, MultiMarkdown, and Kramdown
brew "ttscoff/thelab/apex"
# Spell checker with better logic than ispell
brew "aspell"
# Interpreter for PostScript and PDF
brew "ghostscript"
# Configurable static site generator
brew "hugo"
# Markdown linter and fixer (config in config/md-fixup)
brew "ttscoff/thelab/md-fixup"
# Swiss-army knife of markup format conversion
brew "pandoc"
# Modernized, complete, self-contained TeX/LaTeX engine
brew "tectonic"
# Necessary if using biber with tectonic
# Link to ~/.local/bin/tectonic-biber for best results
# brew "afonsofrancof/taps/biber@2.17"
# LaTeX LSP
brew "texlab"
# Markup-based typesetting system
brew "typst"

### Programming

# Create and run Linux containers using lightweight virtual machines
brew "container"
brew "container-compose"
# Post-modern modal text editor
brew "helix"
# Package management made easy
brew "pixi"
# Software environment for statistical computing
brew "r"
# Safe, concurrent, practical language
brew "rust"
# Extremely fast Python package installer and resolver, written in Rust
brew "uv"

### Media

# Play, record, convert, and stream audio and video
brew "ffmpeg"
# Tools and libraries to manipulate images in many formats
brew "imagemagick"
# Feature-rich command-line audio/video downloader
brew "yt-dlp"

### System and networking

# Mac App Store command-line interface
brew "mas"
# PAM module for reattaching to the user's GUI (Aqua) session (Touch ID sudo in tmux)
brew "pam-reattach"
# Wrapper to colorize and simplify ping's output
brew "prettyping"
# SMART hard drive monitoring
brew "smartmontools"
# Send macOS User Notifications from the command-line
brew "terminal-notifier"
# Internet file retriever
brew "wget"

