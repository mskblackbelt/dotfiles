# Shared git settings, linked to ~/.config/git/config by rcm.
# Identity and credentials come from ~/.gitconfig.local (dotfiles-private) and
# OS-specific settings from ~/.gitconfig.os (tag-darwin/ or tag-linux/ in this
# repo); both are included at the end so they can override anything here.
# The global ignore and attributes files sit next to this one.

# Changes that clearly make git better

[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

# Why not?

[help]
	autocorrect = prompt
[commit]
	cleanup = strip
	verbose = true
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

# delta's look (it's only made the pager on machines that have it; see .gitconfig.os)

[delta]
	features = decorations
	side-by-side = true
[delta "interactive"]
	keep-plus-minus-markers = false
[delta "decorations"]
	commit-decoration-style = blue ol
	commit-style = raw
	file-style = omit
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = "#067a00"
	hunk-header-style = file line-number syntax
	line-numbers = true
	colorMoved = dimmed_zebra

# Diff and merge tools

[diff]
	tool = difftastic
	ignoreSubmodules = dirty
[merge]
	conflictstyle = zdiff3
[difftool]
	prompt = false
[mergetool]
	keepBackup = false
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
	blame = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Aliases

[alias]
	# Abbreviated SHA, description, and history graph of the latest 20 commits
	l = log --pretty=oneline -n 20 --graph --abbrev-commit
	s = status -s
	# Diff between the latest commit and the current state
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"
	# `git di $number`: diff between $number revisions ago and now
	di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"
	p = pull --rebase
	c = clone --recursive
	ca = !git add -A && git commit -av
	# Switch to a branch, creating it if necessary
	go = "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"
	tags = tag -l
	branches = branch -a
	remotes = remote -v
	amend = commit --amend --reuse-message=HEAD
	credit = "!f() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; f"
	reb = "!r() { git rebase -i HEAD~$1; }; r"
	# Branches / tags containing a commit
	fb = "!f() { git branch -a --contains $1; }; f"
	ft = "!f() { git describe --always --contains $1; }; f"
	# Find commits by source code / by commit message
	fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"
	fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"
	# Delete local branches already merged into the current one (keeps main/master)
	dm = "!git branch --merged | grep -vE '^\\*|^[[:space:]]*(main|master)$' | xargs -n 1 git branch -d"
	contributors = shortlog --summary --numbered

# `git clone gh:user/repo`
[url "git@github.com:"]
	insteadOf = "gh:"

[include]
	path = ~/.gitconfig.os
	path = ~/.gitconfig.local
