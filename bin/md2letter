#!/usr/bin/env bash
#
# Convert a markdown file to a PDF letter
set -euo pipefail

if [[ $# -lt 1 ]]; then
	echo "Usage: $(basename "$0") file.md" >&2
	exit 1
fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
input="$1"
output="${input%.md}.pdf"   # PDF lands next to the input file

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}"

if ! /opt/homebrew/bin/pandoc "$input" \
	--from=markdown+link_attributes \
	--template="$script_dir/template-letter.latex" \
	--pdf-engine=tectonic \
	-V graphicspath="." \
	-V graphicspath="$data_dir/images" \
	--output="$output"; then
	echo "Could not convert $input" >&2
	exit 1
fi
