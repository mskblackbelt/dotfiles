#!/usr/bin/env bash
#
# Convert all Markdown documents in the folder to gradable PDFs
# using pandoc, tectonic, and my custom grading template.
set -uo pipefail
shopt -s nullglob

template="${XDG_DATA_HOME:-$HOME/.local/share}/pandoc/templates/grading.latex"

mkdir -p ./to_grade
for file in *.md; do
	(pandoc -f markdown+link_attributes --template="$template" \
		--pdf-engine=tectonic \
		-o "./to_grade/$(basename "$file" .md).pdf" "$file" \
		|| echo "Could not convert $file" >&2) &
done
wait
